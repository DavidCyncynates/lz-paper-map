{
  "name": "lz-paper-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "pnpm check:generated",
    "build": "vinext build",
    "postbuild": "node scripts/prepare-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "generate:catalog-index": "node scripts/generate-catalog-index.mjs",
    "generate:layouts": "node --experimental-strip-types scripts/generate-layout-artifact.mjs",
    "generate:artifacts": "pnpm generate:catalog-index && pnpm generate:layouts",
    "check:catalog-index": "node scripts/generate-catalog-index.mjs --check",
    "check:layouts": "node --experimental-strip-types scripts/generate-layout-artifact.mjs --check",
    "check:generated": "pnpm check:catalog-index && pnpm check:layouts",
    "typecheck": "tsc --noEmit",
    "validate:data": "python3 scripts/update_papers.py --validate-only",
    "test:catalog-index": "node --test scripts/test-catalog-index.mjs",
    "test:layout": "node --experimental-strip-types --test scripts/test-hierarchical-layout.mjs",
    "test:layout-artifact": "node --experimental-strip-types --test scripts/test-map-layout-artifact.mjs",
    "test:map-camera": "node --experimental-strip-types --test scripts/test-map-camera.mjs",
    "test:maintenance": "python3 -m unittest discover -s scripts/tests/maintenance -p 'test_*.py'",
    "test:date-range": "node --experimental-strip-types --test scripts/test-paper-date-range.mjs",
    "test:citation-size": "node --experimental-strip-types --test scripts/test-paper-citation-size.mjs",
    "test:theme": "node --experimental-strip-types --test scripts/test-color-theme.mjs",
    "test:seo": "node --test scripts/test-search-discovery.mjs",
    "check:seo": "node scripts/check-search-artifact.mjs",
    "lint": "oxlint app lib scripts/generate-catalog-index.mjs scripts/generate-layout-artifact.mjs scripts/prepare-pages.mjs scripts/search-discovery.mjs scripts/check-search-artifact.mjs scripts/test-catalog-index.mjs scripts/test-color-theme.mjs scripts/test-hierarchical-layout.mjs scripts/test-map-camera.mjs scripts/test-map-layout-artifact.mjs scripts/test-paper-date-range.mjs scripts/test-paper-citation-size.mjs scripts/test-search-discovery.mjs components/theme-toggle.tsx components/ui/button.tsx components/ui/input.tsx",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
